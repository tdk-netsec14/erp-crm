          "name": "Dashboard Statistics",
          "request": {"method": "GET","header": [{"key": "Authorization","value": "Bearer {{TOKEN}}"}],"url": {"raw": "{{BASE_URL}}/dashboard","host": ["{{BASE_URL}}"],"path": ["dashboard"]}}
