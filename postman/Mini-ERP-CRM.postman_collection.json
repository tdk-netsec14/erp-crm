          "request": {"method": "POST","header": [{"key": "Authorization","value": "Bearer {{TOKEN}}"},{"key": "Content-Type","value": "application/json"}],"body": {"mode": "raw","raw": "{\"customerId\":\"{{CUSTOMER_ID}}\",\"items\":[{\"productId\":\"{{PRODUCT_ID}}\",\"quantity\":5}]}"},"url": {"raw": "{{BASE_URL}}/challans","host": ["{{BASE_URL}}"],"path": ["challans"]}}
        },
        {
